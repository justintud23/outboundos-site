# ── Database ──────────────────────────────────────────────────
# Pooled connection — used by the app at runtime (@prisma/adapter-pg).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outboundos"
# Direct (non-pooled) connection — used by Prisma CLI migrations. On Neon, this
# is the non-pooler host: the pooler's transaction mode breaks the advisory
# locks Prisma takes during `migrate`. Locally (single Postgres, no pooler) it
# is the same as DATABASE_URL; if unset, migrations fall back to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/outboundos"

# ── Clerk ─────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── SendGrid ──────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=outreach@yourdomain.com
SENDGRID_WEBHOOK_SECRET=
# ECDSA public key (from SendGrid Mail Settings → Signed Event Webhook) used to
# verify inbound event webhooks. If unset, signature verification is SKIPPED
# (insecure — dev/local only). Set this in every deployed environment.
SENDGRID_WEBHOOK_VERIFICATION_KEY=
# Secret used to sign per-recipient one-click unsubscribe tokens (RFC 8058
# List-Unsubscribe). Any long random string; used to encrypt/verify the opaque
# ?token= in unsubscribe links. Required to send email.
UNSUBSCRIBE_TOKEN_SECRET=

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
