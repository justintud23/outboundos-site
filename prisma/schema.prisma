generator client {
  provider = "prisma-client-js"
}

// Prisma v7: connection URLs live in prisma.config.ts, not here — the `url` and
// `directUrl` fields are no longer supported in schema.prisma as of v7.
//   - App runtime connects via @prisma/adapter-pg using the pooled DATABASE_URL
//     (see src/lib/db/prisma.ts).
//   - Prisma CLI migrations use prisma.config.ts's datasource.url, which prefers
//     the direct (non-pooled) DIRECT_URL — Neon's pooler breaks the advisory
//     locks Prisma takes during `migrate`.
datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────

enum LeadSource {
  CSV
  MANUAL
  HUBSPOT
  SALESFORCE
  API
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  CONVERTED
  INTERESTED
  NOT_INTERESTED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  BLOCKED
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
  CANCELLED
}

enum MailboxProvider {
  SENDGRID
  MICROSOFT_GRAPH
}

enum MessageEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  SPAM_REPORT
  UNSUBSCRIBED
  DEFERRED
  DROPPED
}

enum ReplyClassification {
  POSITIVE
  NEUTRAL
  NEGATIVE
  OUT_OF_OFFICE
  UNSUBSCRIBE_REQUEST
  REFERRAL
  UNKNOWN
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

enum PromptType {
  LEAD_SCORING
  EMAIL_DRAFT
  REPLY_CLASSIFICATION
  SUBJECT_LINE
}

enum RampPreset {
  CONSERVATIVE
  STANDARD
  AGGRESSIVE
}

enum DomainStatus {
  UNVERIFIED
  HEALTHY
  WARNING
  FAILING
}

enum EmailCheck {
  UNCHECKED
  PENDING
  OK
  RISKY
  INVALID
}

enum SalesforceConnectionStatus {
  CONNECTED
  NEEDS_RECONNECT
  RATE_LIMITED
}

enum SalesforceObject {
  LEAD
  CONTACT
}

enum SfCheckStatus {
  CLEAR
  CUSTOMER
  OPEN_OPPORTUNITY
  OPTED_OUT
  CONVERTED
  NOT_FOUND
}

enum SalesforceJobType {
  LOG_SEND
  LOG_REPLY
  CREATE_LEAD
}

enum SalesforceJobStatus {
  PENDING
  DONE
  FAILED
}

// ─── ORGANIZATION ──────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sending schedule (org timezone). sendDays uses 0=Sun … 6=Sat.
  timezone                   String    @default("America/New_York")
  businessHoursStart         Int       @default(8)
  businessHoursEnd           Int       @default(17)
  sendDays                   Int[]     @default([1, 2, 3, 4, 5])
  escalationEmail            String?
  // Org-wide kill switch. Set by a human, or automatically on Graph 401/403.
  sendingPaused              Boolean   @default(false)
  pausedReason               String?
  guardrailBlockedPhrases    String[]  @default([])
  guardrailAllowedWords      String[]  @default([])
  // Microsoft 365 sending tenant (app-only Graph auth; secret lives in env).
  msTenantId                 String?
  // CAN-SPAM: every commercial email must identify the sender and carry a
  // valid physical postal address. Sending is blocked until it's set.
  businessName               String?
  postalAddress              String?
  // CASL: Canadian recipients need consent, so cold email to them is blocked
  // unless the org explicitly allows it (only with documented consent).
  allowCanadianRecipients    Boolean   @default(false)
  // Rep ownership: CC the org escalation address on reps' reply alerts.
  copyAdminOnReplies         Boolean   @default(true)
  ownershipBannerDismissedAt DateTime?
  // Deliverability 2A: send to catch-all/unknown addresses unless this is on.
  blockRiskyEmails           Boolean   @default(false)
  // Set when a verification outage (no credits / bad key) was alerted; cleared
  // after the next successful check. The reason is shown on Deliverability.
  verificationAlertedAt      DateTime?
  verificationPausedReason   String?
  // Salesforce sync: detects a reconnect to a DIFFERENT Salesforce org even
  // after a disconnect deleted the salesforceConnection row.
  lastSalesforceOrgId        String?

  members              OrgMember[]
  leads                Lead[]
  importBatches        ImportBatch[]
  campaigns            Campaign[]
  sequences            Sequence[]
  mailboxes            Mailbox[]
  drafts               Draft[]
  outboundMessages     OutboundMessage[]
  inboundReplies       InboundReply[]
  unmatchedReplies     UnmatchedReply[]
  auditLogs            AuditLog[]
  promptTemplates      PromptTemplate[]
  leadStatusChanges    LeadStatusChange[]
  sequenceEnrollments  SequenceEnrollment[]
  domainHealth         DomainHealth[]
  businessProfile      BusinessProfile?
  salesforceConnection SalesforceConnection?
  salesforceSyncJobs   SalesforceSyncJob[]

  @@map("organizations")
}

// ─── MEMBERS ───────────────────────────────────────────────────

model OrgMember {
  id             String       @id @default(cuid())
  clerkUserId    String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  name            String?
  email           String?
  // Where this rep's reply alerts go; null → email.
  escalationEmail String?
  senderFirstName String?
  senderLastName  String?
  lastSeenAt      DateTime?

  ownedCampaigns        Campaign[]             @relation("CampaignOwner")
  ownedLeads            Lead[]                 @relation("LeadOwner")
  ownedMailboxes        Mailbox[]              @relation("MailboxOwner")
  salesforceConnections SalesforceConnection[] @relation("SalesforceConnectedBy")

  @@unique([clerkUserId, organizationId])
  @@index([organizationId])
  @@map("org_members")
}

// ─── LEADS ─────────────────────────────────────────────────────

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id])
  ownerId        String?
  owner          OrgMember?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  email       String
  firstName   String?
  lastName    String?
  company     String?
  title       String?
  linkedinUrl String?
  phone       String?

  source LeadSource @default(CSV)
  status LeadStatus @default(NEW)

  score          Int?
  scoreReason    String?
  scoredAt       DateTime?
  // Per-signal explanation of `score` when a BusinessProfile is used.
  scoreBreakdown Json?

  customFields Json?
  // Normalized from the import's country column ('CA', 'US', or raw).
  country      String?

  // Deliverability 2A: mailbox verification of `email` (MillionVerifier).
  emailCheck         EmailCheck @default(UNCHECKED)
  emailCheckResult   String?
  emailCheckedAt     DateTime?
  emailCheckAttempts Int        @default(0)

  // Salesforce sync: link to the matched Lead/Contact, and the pre-send
  // check result that may hold sending on this person.
  salesforceId        String?
  salesforceType      SalesforceObject?
  salesforceAccountId String?
  sfCheckStatus       SfCheckStatus?
  sfCheckedAt         DateTime?
  sfCheckDetail       String?
  sfBlockOverride     Boolean           @default(false)
  sfHeldSince         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts              Draft[]
  outboundMessages    OutboundMessage[]
  inboundReplies      InboundReply[]
  statusChanges       LeadStatusChange[]
  sequenceEnrollments SequenceEnrollment[]
  salesforceSyncJobs  SalesforceSyncJob[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, scoredAt])
  @@index([importBatchId])
  @@index([emailCheck])
  @@index([organizationId, ownerId])
  @@index([organizationId, salesforceId])
  @@map("leads")
}

// ─── LEAD STATUS CHANGES ──────────────────────────────────────

model LeadStatusChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStatus   LeadStatus
  toStatus     LeadStatus
  trigger      String
  actorClerkId String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
  @@index([organizationId, leadId])
  @@map("lead_status_changes")
}

// ─── IMPORT BATCHES ────────────────────────────────────────────

model ImportBatch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fileName     String
  rowCount     Int          @default(0)
  successCount Int          @default(0)
  errorCount   Int          @default(0)
  status       ImportStatus @default(PENDING)
  errorLog     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("import_batches")
}

// ─── CAMPAIGNS ─────────────────────────────────────────────────

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxId      String?
  mailbox        Mailbox?     @relation(fields: [mailboxId], references: [id])
  ownerId        String?
  owner          OrgMember?   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  name        String
  description String?
  status      CampaignStatus @default(DRAFT)

  autoSend         Boolean   @default(false)
  sampleSize       Int       @default(10)
  sampleApprovedAt DateTime?

  // Deliverability 2A: a recorded override of a High content-risk score,
  // valid only while contentOverrideHash matches the current content.
  contentOverrideReason String?
  contentOverrideBy     String?
  contentOverrideAt     DateTime?
  contentOverrideHash   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequences        Sequence[]
  drafts           Draft[]
  outboundMessages OutboundMessage[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([ownerId])
  @@map("campaigns")
}

// ─── SEQUENCES ─────────────────────────────────────────────────

model Sequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps       SequenceStep[]
  drafts      Draft[]
  enrollments SequenceEnrollment[]

  @@index([organizationId])
  @@index([campaignId])
  @@map("sequences")
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  stepNumber Int
  subject    String
  body       String
  delayDays  Int    @default(0)

  // Guidance for the AI-written line inserted at {personalization}.
  personalizationPrompt String?

  // Subject-line A/B test (FIRST step only — follow-ups thread as "Re: <root>").
  // Each SubjectVariant is one arm of the test for this step; the step's own
  // `subject` above is the default used when there is no test (0–1 active variants).
  // winningVariant is the arm a human manually picked as the winner: once set,
  // only the winner is assigned to NEW first-step drafts (losers stop being used);
  // already-queued/sent messages are untouched.
  subjectVariants  SubjectVariant[] @relation("StepVariants")
  winningVariantId String?
  winningVariant   SubjectVariant?  @relation("StepWinner", fields: [winningVariantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts Draft[]

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
  @@map("sequence_steps")
}

// ─── SUBJECT VARIANTS (A/B test arms) ─────────────────────────
// One arm of a subject-line A/B test, attached to a sequence STEP (only the
// first step is tested in practice). Per-variant open/reply rates are DERIVED
// from MessageEvent / InboundReply via OutboundMessage.subjectVariantId — never
// stored as denormalized counters. Variants are ARCHIVED (isArchived) rather
// than hard-deleted so historical stats survive removal.

model SubjectVariant {
  id             String       @id @default(cuid())
  organizationId String
  sequenceStepId String
  sequenceStep   SequenceStep @relation("StepVariants", fields: [sequenceStepId], references: [id], onDelete: Cascade)

  subject    String
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wonByStep        SequenceStep[]    @relation("StepWinner")
  drafts           Draft[]
  outboundMessages OutboundMessage[]

  @@index([sequenceStepId])
  @@index([organizationId])
  @@map("subject_variants")
}

// ─── SEQUENCE ENROLLMENTS ─────────────────────────────────────

model SequenceEnrollment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sequenceId     String
  sequence       Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  currentStepNumber   Int              @default(0)
  status              EnrollmentStatus @default(ACTIVE)
  nextDueAt           DateTime?
  processing          Boolean          @default(false)
  processingStartedAt DateTime?
  startedAt           DateTime         @default(now())
  pausedAt            DateTime?
  stoppedAt           DateTime?
  stoppedReason       String?

  mailboxId      String?
  mailbox        Mailbox? @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  failedAttempts Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts Draft[]

  @@unique([sequenceId, leadId])
  @@index([organizationId])
  @@index([status, nextDueAt])
  @@index([leadId])
  @@index([mailboxId])
  @@map("sequence_enrollments")
}

// ─── MAILBOXES ─────────────────────────────────────────────────

model Mailbox {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          OrgMember?   @relation("MailboxOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  email       String
  displayName String
  isActive    Boolean  @default(true)
  dailyLimit  Int      @default(50)
  sentToday   Int      @default(0)
  lastResetAt DateTime @default(now())

  // Warmup: new mailboxes ramp their daily volume up gradually (see
  // features/mailboxes/warmup.ts) to protect sender reputation. Defaults to
  // enabled for NEW mailboxes; the migration backfills existing mailboxes to
  // false so already-established inboxes are not suddenly throttled.
  warmupEnabled   Boolean  @default(true)
  warmupStartedAt DateTime @default(now())

  // Ramp schedule (see features/mailboxes/warmup.ts). Day 1 = warmupStartedAt.
  rampPreset RampPreset @default(CONSERVATIVE)

  // Circuit breaker: when recent bounce / spam-complaint rates breach safe
  // thresholds (see features/mailboxes/breaker.ts) the mailbox is AUTO-paused to
  // protect domain/IP reputation. These are distinct from isActive (the user's
  // manual on/off) so the UI can show *why* it stopped and we never auto-resume
  // something a human turned off. breakerResetAt is the floor of the breaker's
  // rolling window; it is bumped to now() when a human resumes a tripped mailbox
  // so the bounces that tripped it don't immediately re-trip it.
  autoPaused     Boolean   @default(false)
  pausedAt       DateTime?
  pauseReason    String?
  breakerResetAt DateTime  @default(now())

  provider       MailboxProvider @default(SENDGRID)
  graphUserId    String?
  // Resumable Graph delta URLs (a deltaLink, or a nextLink mid-sync).
  inboxDeltaLink String?
  sentDeltaLink  String?
  lastPolledAt   DateTime?
  // Send-time pacing: earliest moment this mailbox may send again.
  nextSendAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns        Campaign[]
  outboundMessages OutboundMessage[]
  enrollments      SequenceEnrollment[]
  inboundReplies   InboundReply[]
  unmatchedReplies UnmatchedReply[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([ownerId])
  @@map("mailboxes")
}

// ─── DRAFTS ────────────────────────────────────────────────────

model Draft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  campaignId           String?
  campaign             Campaign?           @relation(fields: [campaignId], references: [id])
  sequenceId           String?
  sequence             Sequence?           @relation(fields: [sequenceId], references: [id])
  sequenceStepId       String?
  sequenceStep         SequenceStep?       @relation(fields: [sequenceStepId], references: [id])
  sequenceEnrollmentId String?
  sequenceEnrollment   SequenceEnrollment? @relation(fields: [sequenceEnrollmentId], references: [id])

  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id])

  // A/B test: the variant ASSIGNED to this draft (first-step only; null = no test).
  // subjectEdited is set when a reviewer changes the subject before sending — an
  // edited subject is "manual" and excluded from the variant's stats.
  subjectVariantId String?
  subjectVariant   SubjectVariant? @relation(fields: [subjectVariantId], references: [id], onDelete: SetNull)
  subjectEdited    Boolean         @default(false)

  subject String
  body    String
  status  DraftStatus @default(PENDING_REVIEW)

  guardrailFlags Json?
  isSample       Boolean @default(false)

  createdByClerkId  String?
  approvedByClerkId String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outboundMessages OutboundMessage[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([campaignId, isSample])
  @@map("drafts")
}

// ─── OUTBOUND MESSAGES ─────────────────────────────────────────

model OutboundMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  mailboxId      String
  mailbox        Mailbox      @relation(fields: [mailboxId], references: [id])
  campaignId     String?
  campaign       Campaign?    @relation(fields: [campaignId], references: [id])
  draftId        String?      @unique
  draft          Draft?       @relation(fields: [draftId], references: [id])

  // A/B test attribution key: the variant ACTUALLY sent (first send, unedited
  // subject). Null for follow-ups, edited subjects, and non-test sends. Per-variant
  // stats join opens/replies here. SetNull on variant removal preserves the message.
  subjectVariantId String?
  subjectVariant   SubjectVariant? @relation(fields: [subjectVariantId], references: [id], onDelete: SetNull)

  sgMessageId String?       @unique
  // Our OWN RFC 5322 Message-ID (angle-bracketed), generated and set as the
  // Message-ID header on send. SendGrid's sgMessageId (x-message-id) is an
  // internal id, NOT the RFC Message-ID, so we control our own to thread
  // follow-ups via In-Reply-To / References. Unique; nullable for pre-feature rows.
  messageId   String?       @unique
  subject     String
  body        String
  status      MessageStatus @default(QUEUED)
  sentAt      DateTime?

  scheduledFor        DateTime?
  graphMessageId      String?   @unique
  conversationId      String?
  processing          Boolean   @default(false)
  processingStartedAt DateTime?
  sendAttempts        Int       @default(0)
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events             MessageEvent[]
  inboundReplies     InboundReply[]
  salesforceSyncJobs SalesforceSyncJob[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([mailboxId])
  @@index([organizationId, sentAt])
  @@index([leadId, sentAt])
  @@index([subjectVariantId])
  @@index([status, scheduledFor])
  @@index([conversationId])
  @@map("outbound_messages")
}

// ─── MESSAGE EVENTS ────────────────────────────────────────────
// organizationId is denormalized (no FK) intentionally:
// webhook ingestion must succeed even under partial failure.

model MessageEvent {
  id                String          @id @default(cuid())
  organizationId    String // denormalized — no FK by design; allows event insertion before parent message row is committed
  outboundMessageId String
  outboundMessage   OutboundMessage @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)

  sgEventId         String?          @unique
  eventType         MessageEventType
  providerEventType String?
  providerTimestamp DateTime?
  rawPayload        Json

  createdAt DateTime @default(now())

  @@index([outboundMessageId])
  @@index([organizationId])
  @@index([organizationId, eventType])
  @@map("message_events")
}

// ─── INBOUND REPLIES ───────────────────────────────────────────

model InboundReply {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead             @relation(fields: [leadId], references: [id])
  outboundMessageId String?
  outboundMessage   OutboundMessage? @relation(fields: [outboundMessageId], references: [id])

  rawBody                  String
  classification           ReplyClassification @default(UNKNOWN)
  classificationConfidence Float?

  mailboxId      String?
  mailbox        Mailbox?  @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  graphMessageId String?   @unique
  conversationId String?
  fromEmail      String?
  subject        String?
  notifiedAt     DateTime?
  handledAt      DateTime?

  isRead Boolean @default(false)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  salesforceSyncJobs SalesforceSyncJob[]

  @@index([organizationId])
  @@index([leadId])
  @@index([outboundMessageId])
  @@index([organizationId, isRead])
  @@index([organizationId, receivedAt])
  @@index([leadId, receivedAt])
  @@index([conversationId])
  @@map("inbound_replies")
}

// ─── AUDIT LOGS ────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorClerkId String?
  action       String
  entityType   String
  entityId     String
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([actorClerkId])
  @@map("audit_logs")
}

// ─── PROMPT TEMPLATES ──────────────────────────────────────────

model PromptTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name       String
  promptType PromptType
  version    Int        @default(1)
  body       String
  isActive   Boolean    @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts Draft[]

  // Invariant: only one PromptTemplate per (organizationId, promptType) may have
  // isActive = true at a time. Enforced at app layer — deactivate the previous
  // active record in the same transaction before activating a new version.
  @@unique([organizationId, promptType, version])
  @@index([organizationId])
  @@index([organizationId, promptType, isActive])
  @@map("prompt_templates")
}

// A human reply that couldn't be matched to a lead (e.g. a colleague answering
// for them). Kept separate so InboundReply.leadId stays non-null.
model UnmatchedReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxId      String
  mailbox        Mailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  graphMessageId String       @unique
  conversationId String?
  fromEmail      String
  subject        String
  bodyPreview    String
  receivedAt     DateTime
  notifiedAt     DateTime?
  handledAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([conversationId])
  @@map("unmatched_replies")
}

model CronHeartbeat {
  job        String   @id
  lastRunAt  DateTime
  lastResult Json?

  @@map("cron_heartbeats")
}

// ─── DOMAIN HEALTH ─────────────────────────────────────────────

// Latest DNS/registration check for one sending domain (Graph mailboxes).
model DomainHealth {
  id                 String        @id @default(cuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain             String // lower-case
  status             DomainStatus  @default(UNVERIFIED)
  checks             Json? // DomainCheck[] — see features/deliverability/evaluate-domain.ts
  registeredAt       DateTime?
  registeredAtSource String? // 'rdap' | 'manual'
  lastCheckedAt      DateTime? // last check that produced a result
  lastAttemptAt      DateTime? // last attempt, including "couldn't check"
  lastStatusChangeAt DateTime?
  lastError          String?
  alertedStatus      DomainStatus?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@map("domain_health")
}

// ─── BUSINESS PROFILE ──────────────────────────────────────────

// Industry retargeting: what the org sells, where, and to whom. Drives fit
// scoring, AI personalization context and starter sequences. One per org.
model BusinessProfile {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preset                String
  companySummary        String       @default("")
  services              String[]
  yards                 Json
  alwaysZips            String[]
  neverZips             String[]
  propertyTypes         Json
  decisionTitleKeywords String[]
  downrankTitleKeywords String[]
  bigSites              Int          @default(5)
  bigAcres              Float?
  columnMapping         Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("business_profiles")
}

// ─── SALESFORCE SYNC ───────────────────────────────────────────

// One per org (enforced by the unique organizationId below). Holds the
// encrypted refresh token and the sync preferences an admin controls from
// Settings. heldAlertedAt de-duplicates the daily "leads held" alert.
model SalesforceConnection {
  id                     String                     @id @default(cuid())
  organizationId         String                     @unique
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instanceUrl            String
  loginHost              String
  sfOrgId                String
  sfUserId               String
  sfUsername             String
  sfUserEmail            String?
  refreshTokenEnc        String
  status                 SalesforceConnectionStatus @default(CONNECTED)
  lastError              String?
  rateLimitedUntil       DateTime?
  heldAlertedAt          DateTime?
  customerAccountTypes   String[]                   @default(["Customer"])
  blockOpenOpportunities Boolean                    @default(true)
  logActivity            Boolean                    @default(true)
  connectedAt            DateTime                   @default(now())
  connectedByMemberId    String?
  connectedBy            OrgMember?                 @relation("SalesforceConnectedBy", fields: [connectedByMemberId], references: [id], onDelete: SetNull)
  updatedAt              DateTime                   @updatedAt

  @@map("salesforce_connections")
}

// A queued unit of work synced TO Salesforce (logging a send/reply as a
// Task, or creating a Lead). The unique constraints make enqueue idempotent
// per (type, source record) — retrying a webhook never double-enqueues.
model SalesforceSyncJob {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type              SalesforceJobType
  outboundMessageId String?
  outboundMessage   OutboundMessage?    @relation(fields: [outboundMessageId], references: [id], onDelete: Cascade)
  inboundReplyId    String?
  inboundReply      InboundReply?       @relation(fields: [inboundReplyId], references: [id], onDelete: Cascade)
  status            SalesforceJobStatus @default(PENDING)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lastError         String?
  sfTaskId          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([type, outboundMessageId])
  @@unique([type, inboundReplyId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, status])
  @@map("salesforce_sync_jobs")
}
